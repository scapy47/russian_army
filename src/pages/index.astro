---
import Layout from '../layouts/Layout.astro';
import Background from '../components/AbstractBg.svelte';
import StartQuiz from '../components/StartQuiz.svelte';
import ScrambleRevealText from '../components/utils/ScrambleRevealText.svelte';

---

<Layout>
	<main>
		<section class="h-svh w-full grid grid-rows-3">
			<Background />
			<div class="row-span-2 z-10 flex flex-col justify-center overflow-auto mx-auto">
					<h1 class="text-7xl text-a1">What’s Your</h1>
					<ScrambleRevealText tag={'h2'} className='text-8xl font-mono' speed={40} text='Player' animateOnLoad client:idle />
					<ScrambleRevealText tag={'h2'} className='text-8xl font-mono' speed={40} text='Type?' animateOnLoad client:idle />
			</div>
			<div class="row-start-3 place-items-center">
				<StartQuiz client:idle/>
			</div>
		</section>
		<!-- <footer class="bg-a6 rounded-t-2xl mt-6"> -->
		<!-- 	<h3 class="text-4xl mx-8 font-bold"></h3> -->
		<!-- 	<ul class="mx-12 text-a2 hover:text-a1 active:text-a1 hover:underline active:underline"> -->
		<!-- 		<li><a href="https://en.wikipedia.org/wiki/Bartle_taxonomy_of_player_types">Bartle taxonomy of player types</a></li> -->
		<!-- 	</ul> -->
		<!-- </footer> -->
	</main>
</Layout>
